---
import BaseLayout from '@/layouts/BaseLayout.astro';
import siteData from '@/data/site.json';
---

<BaseLayout
  title="Page Not Found"
  description="The requested page could not be located at The Monarch's Mug. Return to our dining experience or browse our menu."
  noindex={true}
>
  <section class="min-h-[70vh] flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8 text-center bg-brand-cream">
    <div class="max-w-md mx-auto">
      <span class="inline-block p-4 rounded-full bg-brand-gold/15 text-brand-gold mb-6 border border-brand-gold/30">
        <svg class="w-12 h-12 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
        </svg>
      </span>
      <h1 class="font-heading text-4xl sm:text-5xl font-bold text-brand-green mb-4">
        404 - Page Not Found
      </h1>
      <div class="w-16 h-0.5 bg-brand-gold mx-auto mb-6" />
      <p class="text-sm sm:text-base text-brand-text-muted mb-8 leading-relaxed">
        The royal corridors do not lead to this page. Allow us to escort you back to our main dining salon or our curated menu.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="w-full sm:w-auto px-6 py-3 rounded text-xs font-semibold uppercase tracking-wider bg-brand-green text-brand-cream hover:bg-brand-green-light transition-colors"
        >
          Return to Home
        </a>
        <a
          href="/menu"
          class="w-full sm:w-auto px-6 py-3 rounded text-xs font-semibold uppercase tracking-wider bg-brand-gold text-brand-green-dark hover:bg-brand-gold-light transition-colors shadow-gold"
        >
          Browse Our Menu
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
