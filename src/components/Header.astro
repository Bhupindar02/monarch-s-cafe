---
import { Image } from 'astro:assets';
import siteData from '@/data/site.json';
import logoImg from '@/assets/images/logo.jpg';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/menu', label: 'Menu' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/book', label: 'Book a Table' },
];

const pathname = Astro.url.pathname;
const normalizedPath = pathname.replace(/\/$/, '') || '/';
const isHomePage = normalizedPath === '/';
---

<header
  id="site-header"
  data-is-home={isHomePage ? 'true' : 'false'}
  class={`sticky top-0 z-50 w-full transition-all duration-300 ${
    isHomePage
      ? 'bg-transparent border-b border-transparent backdrop-blur-none'
      : 'bg-brand-green-dark/95 backdrop-blur-md border-b border-brand-gold/25 shadow-md'
  }`}
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 transition-all duration-300" id="header-inner">
      
      <!-- Left: Logo & Brand Name -->
      <a
        href="/"
        class="group flex items-center gap-3 sm:gap-4 rounded-lg focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:ring-offset-2 focus-visible:ring-offset-brand-green focus-visible:outline-none"
        aria-label={`${siteData.name} - Home`}
      >
        <div class="relative w-11 h-11 sm:w-12 sm:h-12 rounded-full overflow-hidden border border-brand-gold/60 shadow-gold group-hover:scale-105 transition-transform duration-300 bg-black flex-shrink-0">
          <Image
            src={logoImg}
            alt="The Monarch's Mug Royal Crest"
            width={96}
            height={96}
            format="webp"
            loading="eager"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-heading text-lg sm:text-2xl font-bold tracking-tight text-brand-cream group-hover:text-brand-gold transition-colors leading-tight">
            {siteData.name}
          </span>
          <span class="text-[10px] sm:text-[11px] uppercase tracking-widest text-brand-gold font-semibold">
            Fine Dining & Artisanal Brews
          </span>
        </div>
      </a>

      <!-- Center Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8 lg:gap-10" aria-label="Main Navigation">
        {navLinks.map((link) => {
          const isActive = link.href === '/' ? normalizedPath === '/' : normalizedPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class={`relative py-1 text-sm tracking-wide transition-all duration-200 focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:ring-offset-2 focus-visible:ring-offset-brand-green focus-visible:outline-none rounded ${
                isActive
                  ? 'text-brand-gold font-bold'
                  : 'text-brand-cream/90 hover:text-brand-gold font-medium'
              }`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
              {isActive && (
                <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-brand-gold rounded-full" />
              )}
            </a>
          );
        })}
      </nav>

      <!-- Right Desktop Action: Prominent "Book a Table" -->
      <div class="hidden md:flex items-center gap-4">
        <a
          href="/book"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-full text-xs font-bold uppercase tracking-widest bg-brand-gold text-brand-green-dark hover:bg-brand-gold-light hover:shadow-gold transition-all duration-200 focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:ring-offset-2 focus-visible:ring-offset-brand-green focus-visible:outline-none transform hover:-translate-y-0.5 shadow-sm"
        >
          Book a Table
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-md text-brand-cream hover:text-brand-gold hover:bg-brand-green-surface focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:ring-offset-2 focus-visible:ring-offset-brand-green focus-visible:outline-none transition-colors"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label="Toggle navigation menu"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-nav-panel"
    class="hidden md:hidden bg-brand-green-dark border-t border-brand-green-surface shadow-2xl px-5 py-6 space-y-4 transition-all"
  >
    <nav class="flex flex-col space-y-3" aria-label="Mobile Navigation">
      {navLinks.map((link) => {
        const isActive = link.href === '/' ? normalizedPath === '/' : normalizedPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class={`px-4 py-2.5 rounded-md text-base transition-colors focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:outline-none ${
              isActive
                ? 'bg-brand-green-surface text-brand-gold font-bold border-l-4 border-brand-gold'
                : 'text-brand-cream/90 hover:bg-brand-green-surface hover:text-brand-gold font-medium'
            }`}
            aria-current={isActive ? 'page' : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
    <div class="pt-4 border-t border-brand-green-surface flex flex-col gap-3">
      <a
        href="/book"
        class="w-full text-center py-3 px-4 rounded-full text-xs font-bold uppercase tracking-widest bg-brand-gold text-brand-green-dark hover:bg-brand-gold-light transition-colors shadow-gold focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:outline-none"
      >
        Book a Table
      </a>
      <a
        href={`tel:${siteData.contact.phoneClean}`}
        class="text-center text-xs text-brand-cream/80 hover:text-brand-gold transition-colors py-1 flex items-center justify-center gap-2 focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:outline-none rounded"
      >
        <svg class="w-3.5 h-3.5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Call Us: {siteData.contact.phone}</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  // Home page: transparent over hero, solid after scroll; other pages: always solid
  (() => {
    const header = document.getElementById('site-header');
    const isHome = header?.getAttribute('data-is-home') === 'true';
    const toggle = document.getElementById('mobile-menu-toggle');
    const panel = document.getElementById('mobile-nav-panel');
    const ham = document.getElementById('hamburger-icon');
    const close = document.getElementById('close-icon');

    if (isHome && header) {
      const updateScroll = () => {
        if (window.scrollY > 20) {
          header.classList.add('bg-brand-green-dark/95', 'backdrop-blur-md', 'shadow-md', 'border-brand-gold/25');
          header.classList.remove('bg-transparent', 'border-transparent', 'backdrop-blur-none');
        } else {
          header.classList.remove('bg-brand-green-dark/95', 'backdrop-blur-md', 'shadow-md', 'border-brand-gold/25');
          header.classList.add('bg-transparent', 'border-transparent', 'backdrop-blur-none');
        }
      };
      window.addEventListener('scroll', updateScroll, { passive: true });
      updateScroll();
    }

    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel?.classList.toggle('hidden');
      ham?.classList.toggle('hidden');
      close?.classList.toggle('hidden');
    });
  })();
</script>
