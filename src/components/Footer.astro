---
import { Image } from 'astro:assets';
import siteData from '@/data/site.json';
import logoImg from '@/assets/images/logo.jpg';

const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/menu', label: 'Menu' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/book', label: 'Book a Table' },
];
---

<footer class="bg-brand-green-dark text-brand-cream border-t border-brand-gold/20 pt-16 pb-12">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-14 border-b border-brand-green-surface">
      
      <!-- Brand & Story (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        <a
          href="/"
          class="inline-flex items-center gap-3 group focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:outline-none rounded-lg"
          aria-label={`${siteData.name} - Home`}
        >
          <div class="w-12 h-12 rounded-full overflow-hidden border border-brand-gold/60 shadow-gold group-hover:scale-105 transition-transform bg-black flex-shrink-0">
            <Image
              src={logoImg}
              alt="The Monarch's Mug Crest"
              width={96}
              height={96}
              format="webp"
              loading="lazy"
              class="w-full h-full object-cover"
            />
          </div>
          <div>
            <span class="block font-heading text-2xl font-bold tracking-tight text-brand-gold">
              {siteData.name}
            </span>
            <span class="block text-[11px] uppercase tracking-widest text-brand-cream/70">
              A Royal Blend of Food, Drink & Play
            </span>
          </div>
        </a>
        <p class="text-xs sm:text-sm text-brand-cream/75 leading-relaxed max-w-sm">
          {siteData.description}
        </p>
        
        <!-- Social Icons (Inline SVGs) -->
        <div class="pt-2 flex items-center gap-3">
          <!-- WhatsApp -->
          <a
            href={siteData.contact.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-brand-green-surface border border-brand-gold/20 flex items-center justify-center text-brand-cream hover:text-brand-gold hover:border-brand-gold/50 transition-all focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:outline-none"
            aria-label="Connect with us on WhatsApp"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z" />
            </svg>
          </a>
          <!-- Instagram -->
          <a
            href={siteData.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-brand-green-surface border border-brand-gold/20 flex items-center justify-center text-brand-cream hover:text-brand-gold hover:border-brand-gold/50 transition-all focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:outline-none"
            aria-label="Follow The Monarch's Mug on Instagram"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
          <!-- Facebook -->
          <a
            href={siteData.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-brand-green-surface border border-brand-gold/20 flex items-center justify-center text-brand-cream hover:text-brand-gold hover:border-brand-gold/50 transition-all focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:outline-none"
            aria-label="Visit The Monarch's Mug on Facebook"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Address & Google Maps Link (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="font-heading text-lg font-semibold text-brand-gold tracking-wide">
          Location & Access
        </h3>
        <address class="not-italic text-xs sm:text-sm text-brand-cream/80 space-y-3 leading-relaxed">
          <p>
            {siteData.address.formatted}
          </p>
          <div>
            <a
              href={siteData.social.googleMaps}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-gold hover:text-brand-gold-light underline underline-offset-4 focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:outline-none rounded"
            >
              <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Open in Google Maps</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
          <div class="pt-1">
            <span class="text-brand-cream/60 block text-[11px] uppercase tracking-wider">Phone / WhatsApp</span>
            <a
              href={`tel:${siteData.contact.phoneClean}`}
              class="text-xs sm:text-sm text-brand-cream hover:text-brand-gold font-medium focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:outline-none rounded transition-colors inline-block"
            >
              {siteData.contact.phone}
            </a>
          </div>
          <div>
            <span class="text-brand-cream/60 block text-[11px] uppercase tracking-wider">Email Inquiry</span>
            <a
              href={`mailto:${siteData.contact.email}`}
              class="text-xs sm:text-sm text-brand-cream hover:text-brand-gold focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:outline-none rounded transition-colors inline-block"
            >
              {siteData.contact.email}
            </a>
          </div>
        </address>
      </div>

      <!-- Hours & Service (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="font-heading text-lg font-semibold text-brand-gold tracking-wide">
          Dining Hours
        </h3>
        <p class="text-[11px] text-brand-cream/60 uppercase tracking-wider">Timezone: {siteData.timezone}</p>
        <ul class="space-y-2.5 text-xs sm:text-sm text-brand-cream/80">
          {siteData.hours.display.map((h) => (
            <li class="flex flex-col border-b border-brand-green-surface/60 pb-1.5">
              <span class="font-medium text-brand-cream">{h.days}</span>
              <span class="text-brand-gold">{h.time}</span>
            </li>
          ))}
        </ul>
        <div class="pt-1 text-xs text-brand-cream/70 space-y-1">
          <p><span class="text-brand-cream/50">Lunch Service:</span> {siteData.hours.lunch}</p>
          <p><span class="text-brand-cream/50">Dinner Service:</span> {siteData.hours.dinner}</p>
        </div>
      </div>

      <!-- Small Navigation (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <h3 class="font-heading text-lg font-semibold text-brand-gold tracking-wide">
          Quick Links
        </h3>
        <nav aria-label="Footer Navigation">
          <ul class="space-y-2 text-xs sm:text-sm text-brand-cream/80">
            {navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover:text-brand-gold focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:outline-none rounded transition-colors inline-block py-0.5"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="pt-3">
          <a
            href="/book"
            class="inline-block px-3.5 py-1.5 rounded text-[11px] font-bold uppercase tracking-wider bg-brand-gold text-brand-green-dark hover:bg-brand-gold-light focus-visible:ring-2 focus-visible:ring-brand-gold focus-visible:outline-none transition-colors shadow-sm"
          >
            Reservations
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Bar / Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-brand-cream/60 gap-4">
      <p>© {currentYear} {siteData.name}. All rights reserved.</p>
      <div class="flex items-center gap-4 text-[11px]">
        <span>Patia, Patharagadia, Odisha 751024</span>
        <span class="text-brand-gold/40">•</span>
        <a href={siteData.social.googleMaps} target="_blank" rel="noopener noreferrer" class="hover:text-brand-gold underline underline-offset-2">
          Directions
        </a>
      </div>
    </div>
  </div>
</footer>
